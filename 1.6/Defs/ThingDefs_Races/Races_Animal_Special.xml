			</li>
			<li>
				<bodyGraphicData>
					<texPath>Things/Pawn/Animal/Neutrolope/Neutrolope</texPath>
					<color>(204,167,113)</color>
					<drawSize>2.2</drawSize>
					<shaderType>CutoutComplex</shaderType>
					<shadowData>
						<volume>(0.8, 0.6, 0.6)</volume>
						<offset>(0,0,-0.3)</offset>
					</shadowData>
				</bodyGraphicData>
				<dessicatedBodyGraphicData>
					<texPath>Things/Pawn/Animal/Neutrolope/Dessicated_Neutrolope</texPath>
					<drawSize>2.0</drawSize>
				</dessicatedBodyGraphicData>
				<corpseGraphicData>
					<texPath>Things/Pawn/Animal/Neutrolope/Corpse_Neutrolope</texPath>
