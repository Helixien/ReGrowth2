	<!-- ======================= Rimclaw =============================== -->
	<ThingDef ParentName="AnimalThingBase">
		<defName>RG_Rimclaw</defName>
		<label>rimclaw</label>
		<description>Rimclaws are giant apex predators mutated from iguana, well adapted to highly polluted environments. They are incredibly fast, powerful and intelligent.</description>
		<statBases>
			<MoveSpeed>5.20</MoveSpeed>
			<MarketValue>2500</MarketValue>
			<ComfyTemperatureMin>-8</ComfyTemperatureMin>
			<ComfyTemperatureMax>75</ComfyTemperatureMax>
			<ArmorRating_Sharp>0.50</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.40</ArmorRating_Blunt>
			<ArmorRating_Heat>0.25</ArmorRating_Heat>
			<ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
			<FilthRate>8</FilthRate>
		</statBases>
		<race>
			<deathAction>
				<workerClass>DeathActionWorker_ToxCloud</workerClass>
			</deathAction>
			<body>RG_HumanoidWithHornsAndClaws</body>
			<predator>true</predator>
			<baseBodySize>1</baseBodySize>
			<baseHealthScale>4.5</baseHealthScale>
			<baseHungerRate>1.2</baseHungerRate>
			<foodType>CarnivoreAnimal</foodType>
			<leatherDef>Leather_Lizard</leatherDef>
			<trainability>Advanced</trainability>
			<lifeExpectancy>250</lifeExpectancy>
			<herdMigrationAllowed>false</herdMigrationAllowed>
			<manhunterOnTameFailChance>0.80</manhunterOnTameFailChance>
			<manhunterOnDamageChance>0.90</manhunterOnDamageChance>
			<wildBiomes>
				<Scarlands MayRequire="Ludeon.RimWorld.Odyssey">0.25</Scarlands>
				<Desert>0.01</Desert>
			</wildBiomes>
			<lifeStageAges>
				<li>
					<def>AnimalBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>AnimalJuvenile</def>
					<minAge>0.15</minAge>
				</li>
				<li>
					<def>AnimalAdult</def>
					<minAge>0.5</minAge>
					<soundWounded>RG_Pawn_Rimclaw_Wounded</soundWounded>
					<soundDeath>RG_Pawn_Rimclaw_Death</soundDeath>
					<soundCall>RG_Pawn_Rimclaw_Call</soundCall>
					<soundAngry>RG_Pawn_Rimclaw_Angry</soundAngry>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
		</race>
		<comps>
			<li Class="CompProperties_EggLayer">
				<eggUnfertilizedDef>RG_RimclawEggUnfertilized</eggUnfertilizedDef>
				<eggFertilizedDef>RG_RimclawEggFertilized</eggFertilizedDef>
				<eggFertilizationCountMax>3</eggFertilizationCountMax>
				<eggLayIntervalDays>30</eggLayIntervalDays>
				<eggProgressUnfertilizedMax>0.2</eggProgressUnfertilizedMax>
				<eggCountRange>3</eggCountRange>
			</li>
		</comps>
		<tools>
			<li>
				<label>horn</label>
				<capacities>
					<li>Scratch</li>
					<li>Stab</li>
				</capacities>
				<power>15</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>HornAttackTool</linkedBodyPartsGroup>
			</li>
			<li>
				<label>left claw</label>
				<capacities>
					<li>Scratch</li>
					<li>Stab</li>
				</capacities>
				<power>32</power>
				<cooldownTime>1.5</cooldownTime>
				<linkedBodyPartsGroup>FrontLeftClaws</linkedBodyPartsGroup>
			</li>
			<li>
				<label>right claw</label>
				<capacities>
					<li>Scratch</li>
					<li>Stab</li>
				</capacities>
				<power>32</power>
				<cooldownTime>1.5</cooldownTime>
				<linkedBodyPartsGroup>FrontRightClaws</linkedBodyPartsGroup>
			</li>
			<li>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>25</power>
				<cooldownTime>2.5</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<chanceFactor>0.7</chanceFactor>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>15</power>
				<cooldownTime>1.95</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.4</chanceFactor>
			</li>
		</tools>
		<tradeTags>
			<li>AnimalExotic</li>
		</tradeTags>
	</ThingDef>
