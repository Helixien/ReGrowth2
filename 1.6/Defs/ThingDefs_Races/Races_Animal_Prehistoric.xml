<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!--====================  Woolly Stegosaurus ===========================-->
	<ThingDef ParentName="AnimalThingBase">
		<defName>RG_WoollyStegosaurus</defName>
		<label>woolly stegosaurus</label>
		<description>A variation of the more common “roof lizard”, this creature is a herbivore characterized by their distinctive kite-shaped upright bony scales along the back which help regulate their body temperature and acts as a mating display.\n\nThe Woolly Stegosaurus finds their home in cold biomes, preferring to eat low-lying vegetation due to a short neck and small head. The spines on the end of the tail differ from the regular Stegosaurus, in that they are curved instead of straight. While this does hinder their ability to defend against predators somewhat, they are much better suited to digging into hard soil and flinging it away to exposed nutritious roots.</description>
		<statBases>
			<MoveSpeed>4.3</MoveSpeed>
			<MarketValue>950</MarketValue>
			<ComfyTemperatureMin>-65</ComfyTemperatureMin>
			<ComfyTemperatureMax>32</ComfyTemperatureMax>
			<FilthRate>28</FilthRate>
			<ArmorRating_Blunt>0.22</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.12</ArmorRating_Sharp>
		</statBases>
		<tools>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>14</power>
				<cooldownTime>2.5</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.7</chanceFactor>
			</li>
			<li>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>12</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<chanceFactor>0.5</chanceFactor>
			</li>
			<li>
				<label>left foot</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>8</power>
				<cooldownTime>5</cooldownTime>
				<linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
				<chanceFactor>0.2</chanceFactor>
			</li>
			<li>
				<label>right foot</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>8</power>
				<cooldownTime>5</cooldownTime>
				<linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
				<chanceFactor>0.2</chanceFactor>
			</li>
			<li>
				<label>tail spikes</label>
				<capacities>
					<li>Scratch</li>
					<li>Stab</li>
					<li>Blunt</li>
				</capacities>
				<power>32</power>
				<cooldownTime>2.2</cooldownTime>
				<linkedBodyPartsGroup>RG_TailAttackTool</linkedBodyPartsGroup>
				<chanceFactor>1.6</chanceFactor>
			</li>
		</tools>
		<race>
			<body>RG_SauropodWithTailSpikes</body>
			<baseBodySize>4.0</baseBodySize>
			<baseHealthScale>4.2</baseHealthScale>
			<baseHungerRate>1.43</baseHungerRate>
			<foodType>VegetarianRoughAnimal</foodType>
			<trainability>Intermediate</trainability>
			<herdAnimal>true</herdAnimal>
			<lifeExpectancy>85</lifeExpectancy>
			<leatherDef>RG_DinosaursHideHeavy</leatherDef>
			<meatLabel>dinosaur meat</meatLabel>
			<manhunterOnDamageChance>0.40</manhunterOnDamageChance>
			<herdMigrationAllowed>true</herdMigrationAllowed>
			<nameOnTameChance>1</nameOnTameChance>
			<lifeStageAges>
				<li>
					<def>AnimalBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>AnimalJuvenile</def>
					<minAge>0.6</minAge>
				</li>
				<li>
					<def>AnimalAdult</def>
					<minAge>1.5</minAge>
					<soundCall>RG_StegoSauropod_Call</soundCall>
					<soundAngry>RG_StegoSauropod_Angry</soundAngry>
					<soundWounded>RG_StegoSauropod_Wounded</soundWounded>
					<soundDeath>RG_StegoSauropod_Death</soundDeath>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
		</race>
		<comps>
			<li Class="CompProperties_EggLayer">
				<eggUnfertilizedDef>RG_EggWoollyStegosaurusUnfertilized</eggUnfertilizedDef>
				<eggFertilizedDef>RG_EggWoollyStegosaurusFertilized</eggFertilizedDef>
				<eggFertilizationCountMax>3</eggFertilizationCountMax>
				<eggLayIntervalDays>12</eggLayIntervalDays>
				<eggProgressUnfertilizedMax>0.6</eggProgressUnfertilizedMax>
