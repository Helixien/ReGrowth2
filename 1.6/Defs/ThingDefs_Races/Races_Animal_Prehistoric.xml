			<li Class="CompProperties_Shearable">
				<woolDef>RG_WoolStegosaurus</woolDef>
				<shearIntervalDays>33</shearIntervalDays>
				<woolAmount>125</woolAmount>
			</li>
		</comps>
		<tradeTags>
			<li>AnimalExotic</li>
			<li>AnimalFighter</li>
			<li>AnimalExtinct</li>
		</tradeTags>
	</ThingDef>
