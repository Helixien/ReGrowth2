<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!--=============== Cold Glow ==============-->
	<FleckDef ParentName="FleckBase_Thrown">
		<defName>RG_ColdGlow</defName>
		<graphicData>
			<texPath>Things/Mote/ColdVapor</texPath>
			<shaderType>Mote</shaderType>
		</graphicData>
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<fadeInTime>1.9</fadeInTime>
		<solidTime>0.5</solidTime>
		<fadeOutTime>2.2</fadeOutTime>
	</FleckDef>
	<!--=============== Very Cold Glow ==============-->
	<FleckDef ParentName="FleckBase_Thrown">
		<defName>RG_VeryColdGlow</defName>
		<graphicData>
			<texPath>Things/Mote/VeryColdVapor</texPath>
			<shaderType>Mote</shaderType>
		</graphicData>
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<fadeInTime>2.6</fadeInTime>
		<solidTime>1.5</solidTime>
		<fadeOutTime>3.3</fadeOutTime>
	</FleckDef>
	<!--=============== Splash ==============-->
	<FleckDef ParentName="FleckBase_Thrown">
		<defName>RG_Splash</defName>
		<graphicData>
			<texPath>Things/Mote/splash</texPath>
			<renderInstanced>true</renderInstanced>
			<drawSize>(0.1, 0.1)</drawSize>
		</graphicData>
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<solidTime>0.4</solidTime>
		<fadeOutTime>0.175</fadeOutTime>
		<growthRate>12</growthRate>
	</FleckDef>
	<!--=============== Long Fire Glow ==============-->
	<FleckDef ParentName="FleckBase_Thrown">
		<defName>RG_LongFireGlow</defName>
		<graphicData>
			<texPath>Things/Mote/FireGlow</texPath>
			<shaderType>MoteGlow</shaderType>
			<color>(158,128,128)</color>
		</graphicData>
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<fadeInTime>1.75</fadeInTime>
		<solidTime>3.08</solidTime>
		<fadeOutTime>2.8</fadeOutTime>
	</FleckDef>

	<FleckDef ParentName="FleckBase_RandomGraphic_Thrown">
		<defName>RG_Puddle</defName>
		<randomGraphics>
			<li>
				<texPath>Things/Filth/Puddle/PuddleA</texPath>
				<graphicClass>Graphic_Fleck</graphicClass>
				<shaderType>Transparent</shaderType>
				<renderInstanced>false</renderInstanced>
			</li>
		</randomGraphics>
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<fadeInTime>0.5</fadeInTime>
		<solidTime>10.5</solidTime>
		<fadeOutTime>1.5</fadeOutTime>
	</FleckDef>

	<FleckDef ParentName="FleckBase_RandomGraphic_Thrown">
		<defName>RG_WaterSpatter</defName>
		<randomGraphics>
			<li>
				<texPath>Things/Filth/WaterSpatter/SpatterA</texPath>
				<graphicClass>Graphic_Fleck</graphicClass>
				<shaderType>Transparent</shaderType>
				<renderInstanced>false</renderInstanced>
			</li>
			<li>
				<texPath>Things/Filth/WaterSpatter/SpatterB</texPath>
				<graphicClass>Graphic_Fleck</graphicClass>
				<shaderType>Transparent</shaderType>
				<renderInstanced>false</renderInstanced>
			</li>
			<li>
				<texPath>Things/Filth/WaterSpatter/SpatterC</texPath>
				<graphicClass>Graphic_Fleck</graphicClass>
				<shaderType>Transparent</shaderType>
				<renderInstanced>false</renderInstanced>
			</li>
		</randomGraphics>
		<altitudeLayer>MoteOverhead</altitudeLayer>
		<fadeInTime>0.1</fadeInTime>
		<solidTime>0.2</solidTime>
		<fadeOutTime>0.3</fadeOutTime>
	</FleckDef>
</Defs>