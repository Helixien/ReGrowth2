<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!--=============== Toxigrass ==============-->
	<ThingDef ParentName="RG_GrassBase">
		<defName>RG_Plant_ToxiGrass</defName>
		<label>toxigrass</label>
		<description>Wild toxin-resistant grass. Grows anywhere there is a little light and minimally fertile ground.</description>
		<statBases>
			<Nutrition>0.25</Nutrition>
			<Flammability>1.5</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Plant/ToxiGrass</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<plant>
			<pollution>Any</pollution>
			<fertilityMin>0.05</fertilityMin>
			<fertilitySensitivity>0</fertilitySensitivity>
		</plant>
	</ThingDef>
	<ThingDef ParentName="RG_TallGrassBase">
		<defName>RG_Plant_TallToxiGrass</defName>
		<label>tall toxigrass</label>
		<description>Wild tall toxin-resistant grass.</description>
		<statBases>
			<Nutrition>0.25</Nutrition>
			<Flammability>1.5</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Plant/ToxiGrass</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<plant>
			<pollution>Any</pollution>
			<fertilityMin>0.05</fertilityMin>
			<fertilitySensitivity>0</fertilitySensitivity>
		</plant>
	</ThingDef>
	<!--=============== Mutated Fungus==============-->
	<ThingDef ParentName="PlantBase">
		<defName>RG_Plant_MutatedFungus</defName>
		<label>mutated fungus</label>
		<description>A strange toxin-adapted fungus growing in pairs. It has no nutritious value.</description>
		<statBases>
			<MaxHitPoints>40</MaxHitPoints>
			<Flammability>0.2</Flammability>
			<Beauty>-2</Beauty>
			<BeautyOutdoors>-2</BeautyOutdoors>
			<Nutrition>0</Nutrition>
		</statBases>
		<pathCost>9</pathCost>
		<graphicData>
			<texPath>Things/Plant/MutatedFungus</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<hideAtSnowOrSandDepth>0.4</hideAtSnowOrSandDepth>
		<ingestible>
			<preferability>NeverForNutrition</preferability>
		</ingestible>
		<plant>
			<fertilitySensitivity>0</fertilitySensitivity>
			<pollution>Any</pollution>
			<growDays>3</growDays>
			<harvestWork>40</harvestWork>
			<maxMeshCount>4</maxMeshCount>
			<wildClusterRadius>4</wildClusterRadius>
			<wildClusterWeight>8</wildClusterWeight>
			<visualSizeRange>0.6~0.75</visualSizeRange>
			<topWindExposure>0.2</topWindExposure>
			<wildOrder>1</wildOrder>
		</plant>
	</ThingDef>
	<!--=============== Glow Leaf==============-->
	<ThingDef ParentName="PlantBase">
		<defName>RG_Plant_GlowLeaf</defName>
		<label>glow leaf</label>
		<description>A toxin-resistant fern with a bluish colour. It glows in the dark.</description>
		<statBases>
			<MaxHitPoints>60</MaxHitPoints>
			<Flammability>0.2</Flammability>
			<Nutrition>0.12</Nutrition>
			<Beauty>0</Beauty>
			<BeautyOutdoors>0</BeautyOutdoors>
		</statBases>
		<graphicData>
			<texPath>Things/Plant/GlowLeaf</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<hideAtSnowOrSandDepth>0.4</hideAtSnowOrSandDepth>
		<ingestible/>
		<plant>
			<pollution>Any</pollution>
			<growDays>3.5</growDays>
			<visualSizeRange>0.6~1.0</visualSizeRange>
			<topWindExposure>0.2</topWindExposure>
			<wildOrder>1</wildOrder>
			<purpose>Beauty</purpose>
		</plant>
		<comps>
			<li Class="CompProperties_Glower">
				<glowRadius>3</glowRadius>
				<glowColor>(119,131,201,0)</glowColor>
			</li>
		</comps>
	</ThingDef>
	<!--=============== Lure Weed==============-->
	<ThingDef ParentName="PlantBase">
		<defName>RG_Plant_LureWeed</defName>
		<label>lure weed</label>
		<description>A toxin-resistant flower-like plant with long stems and glowing pods. Tribal legends say it is connected to a large monster buried under the ground that uses it to lure pray close to it.</description>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<Flammability>0.2</Flammability>
			<Nutrition>0.22</Nutrition>
			<Beauty>-4</Beauty>
			<BeautyOutdoors>-4</BeautyOutdoors>
		</statBases>
		<graphicData>
			<texPath>Things/Plant/LureWeed</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<hideAtSnowOrSandDepth>0.7</hideAtSnowOrSandDepth>
		<ingestible/>
		<plant>
			<pollution>Any</pollution>
			<growDays>3.5</growDays>
			<maxMeshCount>4</maxMeshCount>
			<visualSizeRange>0.65~0.85</visualSizeRange>
			<topWindExposure>0.25</topWindExposure>
			<wildClusterRadius>4</wildClusterRadius>
			<wildClusterWeight>8</wildClusterWeight>
			<wildOrder>1</wildOrder>
			<purpose>Beauty</purpose>
		</plant>
		<comps>
			<li Class="CompProperties_Glower">
				<glowRadius>4</glowRadius>
				<glowColor>(201,168,63,0)</glowColor>
			</li>
		</comps>
	</ThingDef>
	<!--=========================== Mutated Fern ==========================-->
	<ThingDef ParentName="PlantBase">
		<defName>RG_Plant_MutatedFern</defName>
		<label>mutated fern</label>
		<description>A toxin-resistant fern adapted to thrive in highly polluted areas.</description>
		<graphicData>
			<texPath>Things/Plant/MutatedFern</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<drawSize>1.5</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<Flammability>0.6</Flammability>
			<Nutrition>0.15</Nutrition>
			<Beauty>-2</Beauty>
			<BeautyOutdoors>-2</BeautyOutdoors>
		</statBases>
		<hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
		<ingestible/>
		<plant>
			<pollution>Any</pollution>
			<fertilityMin>0.05</fertilityMin>
			<fertilitySensitivity>0.2</fertilitySensitivity>
			<growDays>15</growDays>
			<harvestWork>75</harvestWork>
			<maxMeshCount>4</maxMeshCount>
			<wildClusterRadius>4</wildClusterRadius>
			<wildClusterWeight>4</wildClusterWeight>
			<visualSizeRange>0.35~0.85</visualSizeRange>
			<topWindExposure>0.3</topWindExposure>
			<wildOrder>1</wildOrder>
			<pollutedGraphicPath>Things/Plant/MutatedFern</pollutedGraphicPath>
		</plant>
	</ThingDef>
	<!--=========================== Tripaloski ==========================-->
	<ThingDef ParentName="PlantBase">
		<defName>RG_Tripaloski</defName>
		<label>tripaloski</label>
		<description>A bright red toxin-resistant mushroom. Being the result of mutation it only grows in wastelands and can not be cultivated.</description>
		<graphicData>
			<texPath>Things/Plant/Tripaloski</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<Beauty>0</Beauty>
			<Nutrition>0.4</Nutrition>
			<Beauty>-5</Beauty>
			<BeautyOutdoors>-5</BeautyOutdoors>
		</statBases>
		<pathCost>5</pathCost>
		<ingestible/>
		<plant>
			<fertilityMin>0.04</fertilityMin>
			<fertilitySensitivity>0.1</fertilitySensitivity>
			<growDays>45</growDays>
			<maxMeshCount>9</maxMeshCount>
			<dieIfLeafless>true</dieIfLeafless>
			<harvestYield>20</harvestYield>
			<harvestTag>Standard</harvestTag>
			<harvestedThingDef>RawFungus</harvestedThingDef>
			<neverBlightable>true</neverBlightable>
			<visualSizeRange>0.3~0.5</visualSizeRange>
			<topWindExposure>0.1</topWindExposure>
			<purpose>Food</purpose>
			<pollution>Any</pollution>
		</plant>
	</ThingDef>
	<!--=========================== Toxipine Trees ==========================-->
	<ThingDef ParentName="TreeBase">
		<defName>RG_Plant_TreeToxipine</defName>
		<label>toxipine tree</label>
		<description>A toxin-resistant conifer. Its colour is half faded to brown.</description>
		<graphicData>
			<texPath>Things/Plant/Toxipine</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<shadowData>
				<volume>(0.15, 0.3, 0.15)</volume>
				<offset>(0,0,-0.38)</offset>
			</shadowData>
		</graphicData>
		<statBases>
			<Beauty>-1</Beauty>
			<Nutrition>0.65</Nutrition>
		</statBases>
		<ingestible/>
		<plant>
			<growDays>32</growDays>
			<visualSizeRange>1.3~3.2</visualSizeRange>
			<harvestWork>700</harvestWork>
			<harvestYield>16</harvestYield>
			<pollution>Any</pollution>
			<pollutedGraphicPath>Things/Plant/Toxipine</pollutedGraphicPath>
		</plant>
	</ThingDef>
	<!--=========================== Splitpine Trees ==========================-->
	<ThingDef ParentName="TreeBase">
		<defName>RG_Plant_TreeSplitpine</defName>
		<label>splitpine tree</label>
		<description>A large heavily mutated toxin-resistant conifer. Its colour is faded to brown.</description>
		<graphicData>
			<texPath>Things/Plant/SplitPine</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<shadowData>
				<volume>(0.15, 0.3, 0.15)</volume>
				<offset>(0,0,-0.38)</offset>
			</shadowData>
		</graphicData>
		<statBases>
			<Beauty>-1</Beauty>
			<Nutrition>0.65</Nutrition>
		</statBases>
		<ingestible/>
		<plant>
			<growDays>42</growDays>
			<visualSizeRange>1.8~3.5</visualSizeRange>
			<harvestWork>850</harvestWork>
			<harvestYield>28</harvestYield>
			<pollution>Any</pollution>
		</plant>
	</ThingDef>
	<!--=========================== Toxiteak Trees ==========================-->
	<ThingDef ParentName="TreeBase">
		<defName>RG_Plant_TreeToxiTeak</defName>
		<label>toxiteak tree</label>
		<description>A toxin-resistant hardwood tree that grows in polluted climates.</description>
		<graphicData>
			<texPath>Things/Plant/TreeToxiTeak</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<statBases>
			<Beauty>2</Beauty>
			<BeautyOutdoors>2</BeautyOutdoors>
		</statBases>
		<plant>
			<growDays>35.5</growDays>
			<pollution>Any</pollution>
			<harvestWork>1600</harvestWork>
			<harvestYield>50</harvestYield>
			<visualSizeRange>1.0~2.2</visualSizeRange>
		</plant>
	</ThingDef>
</Defs>