<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- This folder is loaded only for RimWorld 1.6 with Vanilla Landmarks Expanded active. -->
	<Operation Class="PatchOperationSequence" MayRequire="VanillaExpanded.VExplorationE">
		<operations>
			<!-- Extend the relevant Boreal Forest permissions to Aspen Forest. -->
			<li Class="PatchOperationConditional">
				<xpath>/Defs/TileMutatorDef[defName="VEE_DetachedIceberg" or defName="VEE_IceAndFire" or defName="VEE_DryRiver" or defName="VEE_MangroveTerrain" or defName="VEE_BurnedForest" or defName="VEE_AuburnTree_Oaks" or defName="VEE_AuburnTree_Poplars" or defName="VEE_AuburnTree_Maples" or defName="VEE_AuburnTree_Birches"]/biomeWhitelist[not(li="RG_AspenForest")]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/TileMutatorDef[defName="VEE_DetachedIceberg" or defName="VEE_IceAndFire" or defName="VEE_DryRiver" or defName="VEE_MangroveTerrain" or defName="VEE_BurnedForest" or defName="VEE_AuburnTree_Oaks" or defName="VEE_AuburnTree_Poplars" or defName="VEE_AuburnTree_Maples" or defName="VEE_AuburnTree_Birches"]/biomeWhitelist[not(li="RG_AspenForest")]</xpath>
					<value>
						<li MayRequire="VanillaExpanded.VExplorationE">RG_AspenForest</li>
					</value>
				</match>
			</li>
			<!-- Keep ReGrowth's palms in the tropical beach worker's restricted flora list. -->
			<li Class="PatchOperationConditional">
				<xpath>/Defs/TileMutatorDef[defName="VEE_TropicalBeachFlora"]/plantKinds[not(li="RG_Plant_TreeDwarfPalm")]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/TileMutatorDef[defName="VEE_TropicalBeachFlora"]/plantKinds[not(li="RG_Plant_TreeDwarfPalm")]</xpath>
					<value>
						<li MayRequire="VanillaExpanded.VExplorationE">RG_Plant_TreeDwarfPalm</li>
					</value>
				</match>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>/Defs/TileMutatorDef[defName="VEE_TropicalBeachFlora"]/plantKinds[not(li="RG_Plant_TallPalmTree")]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/TileMutatorDef[defName="VEE_TropicalBeachFlora"]/plantKinds[not(li="RG_Plant_TallPalmTree")]</xpath>
					<value>
						<li MayRequire="VanillaExpanded.VExplorationE">RG_Plant_TallPalmTree</li>
					</value>
				</match>
			</li>
			<!-- Match the existing megafauna entries' forced spawn chance. -->
			<li Class="PatchOperationConditional">
				<xpath>/Defs/TileMutatorDef[defName="VEE_Megafauna"]/modExtensions/li[@Class="VEF.Maps.TileMutatorExtension"]/forcedPawnKindDefs[not(li[forcedPawnKindDef="RG_WoollyStegosaurus"])]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/TileMutatorDef[defName="VEE_Megafauna"]/modExtensions/li[@Class="VEF.Maps.TileMutatorExtension"]/forcedPawnKindDefs[not(li[forcedPawnKindDef="RG_WoollyStegosaurus"])]</xpath>
					<value>
						<li MayRequire="VanillaExpanded.VExplorationE">
							<forcedPawnKindDef>RG_WoollyStegosaurus</forcedPawnKindDef>
							<forcedPawnKindDefChance>0.1</forcedPawnKindDefChance>
						</li>
					</value>
				</match>
			</li>
			<!-- Preserve VAE's existing definition when it is active. Without VAE, only
			     allow biomes with Thrinaxodon: the worker cannot handle an empty nocturnal pool. -->
			<li Class="PatchOperationFindMod">
				<mods>
					<li>Vanilla Animals Expanded</li>
				</mods>
				<nomatch Class="PatchOperationConditional">
					<xpath>/Defs/TileMutatorDef[defName="VEE_NocturnalFauna"]</xpath>
					<match Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationAttributeSet">
								<xpath>/Defs/TileMutatorDef[defName="VEE_NocturnalFauna"]</xpath>
								<attribute>MayRequire</attribute>
								<value>VanillaExpanded.VExplorationE</value>
							</li>
							<li Class="PatchOperationReplace">
								<xpath>/Defs/TileMutatorDef[defName="VEE_NocturnalFauna"]/biomeWhitelist</xpath>
								<value>
									<biomeWhitelist>
										<li>TemperateForest</li>
										<li>Grasslands</li>
										<li>TemperateSwamp</li>
										<li>TropicalRainforest</li>
										<li>TropicalSwamp</li>
										<li>AridShrubland</li>
									</biomeWhitelist>
								</value>
							</li>
						</operations>
					</match>
					<!-- Also support loaders that have already removed the unmet VAE definition. -->
					<nomatch Class="PatchOperationAdd">
						<xpath>/Defs</xpath>
						<value>
							<TileMutatorDef MayRequire="VanillaExpanded.VExplorationE">
								<defName>VEE_NocturnalFauna</defName>
								<label>nocturnal fauna</label>
								<description>Nocturnal and crepuscular animals appear in greater numbers here.</description>
								<workerClass>VanillaExplorationExpanded.TileMutatorWorker_Nocturnal</workerClass>
								<chanceOnNonLandmarkTile>0.02</chanceOnNonLandmarkTile>
								<biomeWhitelist>
									<li>TemperateForest</li>
									<li>Grasslands</li>
									<li>TemperateSwamp</li>
									<li>TropicalRainforest</li>
									<li>TropicalSwamp</li>
									<li>AridShrubland</li>
								</biomeWhitelist>
								<animalDensityRange>0.3~7</animalDensityRange>
								<pollutionRange>0~0.25</pollutionRange>
								<categories>
									<li>VEE_AnimalDensities</li>
								</categories>
							</TileMutatorDef>
						</value>
					</nomatch>
				</nomatch>
			</li>
			<!-- Succulents are optional; keep Aspen excluded alongside the other cold biomes. -->
			<li Class="PatchOperationConditional">
				<xpath>/Defs/TileMutatorDef[defName="VEE_WildSucculents"]/biomeBlacklist[not(li="RG_AspenForest")]</xpath>
				<match Class="PatchOperationAdd">
					<xpath>/Defs/TileMutatorDef[defName="VEE_WildSucculents"]/biomeBlacklist[not(li="RG_AspenForest")]</xpath>
					<value>
						<li MayRequire="VanillaExpanded.VPlantsESucculents">RG_AspenForest</li>
					</value>
				</match>
			</li>
		</operations>
	</Operation>
</Patch>
