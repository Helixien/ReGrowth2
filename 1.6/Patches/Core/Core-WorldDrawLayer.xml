<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!--For any modders creating Planet Layers, you will need to either MayRequire or patch the below into your worldDrawLayers-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/PlanetLayerDef[defName="Surface"]/worldDrawLayers</xpath>
		<value>
			<li>ReGrowthCore.WorldDrawLayer_Beautification</li>
		</value>
	</Operation>
</Patch>