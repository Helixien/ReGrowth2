<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- ================ Plant Density ================ -->
	<Operation Class="ModSettingsFramework.PatchOperationModOption">
		<defaultValue>True</defaultValue>
		<label>Increase vanilla plant density</label>
		<tooltip>Makes all biomes more lush. Does only affect performance on low end machines. All ReGrowth mods are build around this setting enabled. (Default: True)</tooltip>
		<id>RG_IncreaseVanillaPlantDensity</id>
		<category>RG_GeneralSettings</category>
		<order>0</order>
		<operations>
			<!-- ================ Biome Boreal Forest ================ -->
			<li Class="PatchOperationReplace">
				<xpath>/Defs/BiomeDef[defName="BorealForest"]/plantDensity</xpath>
				<value>
					<plantDensity>1.0</plantDensity>
				</value>
			</li>
			<!-- ================ Biome Tundra ================ -->
			<li Class="PatchOperationReplace">
				<xpath>/Defs/BiomeDef[defName="Tundra"]/plantDensity</xpath>
				<value>
