	<!-- ================ Realistic Faction Placement ================ -->
	<Operation Class="ModSettingsFramework.PatchOperationModOption">
		<defaultValue>True</defaultValue>
		<label>Enable realistic faction placement</label>
		<tooltip>Prevent factions from spawning in extreme biomes like sea ice or extreme deserts unless it makes logical sense for them. Might lead to issues on tiny world maps. (Default: True)</tooltip>
