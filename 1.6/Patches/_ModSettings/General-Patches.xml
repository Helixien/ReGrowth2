	<!-- ================ Steel does not burn ================ -->
	<Operation Class="ModSettingsFramework.PatchOperationModOption">
		<defaultValue>True</defaultValue>
		<label>Steel does not burn</label>
		<tooltip>Makes it so steel wont burn because its steel. (Default: True)</tooltip>
		<id>RG_SteelDoesNotBurn</id>
		<category>RG_GeneralSettings</category>
		<order>2</order>
		<operations>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThingDef[defName="Steel"]/stuffProps/statFactors/Flammability</xpath>
				<value>
					<Flammability>0</Flammability>
				</value>
			</li>
		</operations>
	</Operation>
	<!-- ================ Bathe joy activity chance ================ -->
	<Operation Class="ModSettingsFramework.PatchOperationSliderFloat">
		<label>Base chance of bathing</label>
		<tooltip>Adjust the base chance of colonists bathing as a recreational activity. Default: 2.5</tooltip>
		<id>RG_BaseChanceBathingActivity</id>
		<category>RG_GeneralSettings</category>
		<order>5</order>
		<xpath>Defs/JoyGiverDef[defName="RG_BatheJoyGiver"]/baseChance</xpath>
		<range>0~10</range>
		<defaultValue>2.5</defaultValue>
	</Operation>
